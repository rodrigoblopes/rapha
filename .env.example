# Rapha — environment contract.
#
# This file documents variable NAMES and PURPOSES. It never contains real values.
# The real .env lives in %RAPHA_HOME%, outside OneDrive. Copy this there, not here.
#
#     copy .env.example %USERPROFILE%\.rapha\.env

# ── Paths ────────────────────────────────────────────────────────────────────
# Root for all data. MUST be outside the OneDrive root (ADR-002).
RAPHA_HOME=C:\Users\<you>\.rapha

# Extracted Projeto 60 Dias data. Defaults to %RAPHA_HOME%\protocol.
PROTOCOL_DIR=

# Source course material, read-only, used once during extraction.
COURSE_DIR=

# ── Garmin ───────────────────────────────────────────────────────────────────
# The account to log in as. There is NO password variable and never will be:
# `rapha login` prompts once (handling MFA) and stores OAuth tokens only (ADR-001).
GARMIN_EMAIL=

# Where OAuth tokens are written. Defaults to %RAPHA_HOME%.
GARMIN_TOKEN_STORE=

# ── Athlete parameters ───────────────────────────────────────────────────────
# Inputs to the Navy body-fat formula and the energy maths.
# Integers only: height in millimetres, birth year, sex as M|F.
ATHLETE_HEIGHT_MM=
ATHLETE_BIRTH_YEAR=
ATHLETE_SEX=

# ── Nutrition targets ────────────────────────────────────────────────────────
# Energy deficit against MEASURED TDEE (ADR-005), in basis points. 1750 = 17.5%.
DEFICIT_BPS=1750

# Protein target in g/kg bodyweight, x10 to stay integer. 19 = 1.9 g/kg.
PROTEIN_G_PER_KG_X10=19

# Days of Garmin expenditure averaged into the TDEE estimate. 14-28 (ADR-005).
TDEE_WINDOW_DAYS=21

# ── Portal ───────────────────────────────────────────────────────────────────
# Local portal. Binds 127.0.0.1 only, always.
PORTAL_PORT=8766

# ── Photo analysis (optional, ADR-015) ───────────────────────────────────────
# Uploading progress photos writes an immediate vision review using the **Claude Code
# CLI on your Max plan** — no API key, no per-call cost. It just needs the `claude` CLI
# installed (it is, if you use Claude Code). If it lives somewhere find_claude can't
# see, point at it here; otherwise leave blank.
CLAUDE_CLI=
# Optional: force a specific model for the review (else the CLI's session default).
RAPHA_VISION_MODEL=
